  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "electron": "electron .",
    "build:win": "vite build && node -e \"console.log('Checking build output...'); const fs = require('fs'); const path = require('path'); const files = fs.readdirSync('dist'); console.log('Dist files count:', files.length);\"",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
