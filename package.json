{
  "name": "sensorium-bridge-matrix",
  "author": "Nico Maedler <icon.maedler@gmail.com>",
  "copyright": "Copyright (c) 2026 Nico Maedler. All Rights Reserved. Proprietary & Confidential Engine Architecture.",
  "license": "Proprietary",
  "private": true,
  "version": "2.5.0",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "electron": "electron .",
    "build:win": "npm run build && electron-builder --win portable",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.mjs tests/*.test.ts",
    "check": "npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/d3": "^7.4.3",
    "@vitejs/plugin-react": "^5.0.4",
    "adm-zip": "^0.6.0",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^6.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "build": {
    "appId": "com.designico.sensorium.preview",
    "productName": "Sensorium Preview",
    "directories": {
      "output": "dist/windows"
    },
    "files": [
      "dist/index.html",
      "dist/assets/**",
      "electron-main.cjs",
      "package.json",
      "!dist/server.cjs",
      "!dist/**/*.map",
      "!node_modules/**"
    ],
    "asar": true,
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Sensorium-Preview-${version}-Windows-${arch}.${ext}"
    }
  }
}
